<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background-color: #f8f9fa;
            color: #333;
            margin: 0;
            padding: 20px;
            text-align: center;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        .hero-section {
            background: white;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            margin-bottom: 30px;
        }

        h1 { color: #2c3e50; font-size: 2.8rem; margin-bottom: 10px; }

        .info-bar {
            display: flex;
            justify-content: center;
            gap: 20px;
            color: #666;
            margin-bottom: 20px;
        }

        .status-badge {
            display: inline-block;
            padding: 8px 20px;
            border-radius: 50px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .open { background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
        .closed { background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }

        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }

        .menu-card {
            background: white;
            padding: 20px;
            border-radius: 15px;
            text-align: left;
            border-bottom: 4px solid #e67e22;
            box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        }

        .menu-card h3 { margin: 0 0 10px 0; color: #2c3e50; font-size: 1.1rem; }
        .item-price { color: #27ae60; font-weight: bold; float: right; }
    </style>
</head>
<body>

    <%- include('./partials/nav') %>

    <h1>Welcome to <%= bistro.name %></h1>
    <p><strong>Location:</strong> <%= bistro.address %></p>
    <p><strong>Contact:</strong> <%= bistro.phone %></p>

    <p>Status:
        <% if (bistro.isOpen) { %>
            <span class="open">Yes, we are open!</span>
        <% } else { %>
            <span class="closed">Sorry, we are closed.</span>
        <% } %>
    </p>

    <hr>

    <h2>Our Menu</h2>

    <% bistro.menu.forEach((item) => { %>
        <div class="menu-item">
            <h3><%= item.name %> - $<%= item.price %></h3>
            <p><em>Category: <%= item.category %></em> | Rating: <%= item.rating %>/5</p>
            <p><%= item.details %></p>
        </div>
    <% }) %>

</body>
</html>
